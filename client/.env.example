# ─────────────────────────────────────────────────────────────────────────
# Vite client environment
# Copy to `.env.local` for local development (Vite loads .env.local automatically).
# ─────────────────────────────────────────────────────────────────────────

# API base URL (without the /api suffix).
#
# Local dev:   omit this variable : the Vite dev server proxies /api →
#              http://localhost:5000/api (see vite.config.ts), so axios uses
#              a relative baseURL of "/api".
#
# Production:  set to your deployed Express server origin, e.g.
#              VITE_API_BASE_URL=https://dss-api.railway.app
#              The axios instance appends /api automatically.
VITE_API_BASE_URL=
